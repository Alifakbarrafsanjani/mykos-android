<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:background="@drawable/bg_liquid_glass_card"
    android:clickable="true"
    android:elevation="@dimen/elevation_sm"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:padding="@dimen/spacing_sm">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivKamarFoto"
        android:layout_width="@dimen/kamar_thumb_size"
        android:layout_height="@dimen/kamar_thumb_size"
        android:background="@color/surface_elevated"
        android:contentDescription="@string/cd_foto_kamar"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.MyKos.ImageRounded"
        tools:src="@drawable/ic_image_placeholder" />

    <TextView
        android:id="@+id/tvNomorKamar"
        style="@style/TextAppearance.MyKos.Subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@id/ivChevron"
        app:layout_constraintStart_toEndOf="@id/ivKamarFoto"
        app:layout_constraintTop_toTopOf="@id/ivKamarFoto"
        tools:text="Kamar 101" />

    <TextView
        android:id="@+id/tvHargaKamar"
        style="@style/TextAppearance.MyKos.BodySecondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xxs"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@id/ivChevron"
        app:layout_constraintStart_toStartOf="@id/tvNomorKamar"
        app:layout_constraintTop_toBottomOf="@id/tvNomorKamar"
        tools:text="Rp 750.000/bulan" />

    <TextView
        android:id="@+id/tvStatusBadge"
        style="@style/TextAppearance.MyKos.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:background="@drawable/bg_status_terisi"
        android:paddingHorizontal="@dimen/spacing_sm"
        android:paddingVertical="@dimen/spacing_xxs"
        android:textColor="@color/on_success_container"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ivKamarFoto"
        app:layout_constraintStart_toStartOf="@id/tvNomorKamar"
        app:layout_constraintTop_toBottomOf="@id/tvHargaKamar"
        tools:text="@string/status_terisi" />

    <ImageView
        android:id="@+id/ivChevron"
        android:layout_width="@dimen/icon_size_md"
        android:layout_height="@dimen/icon_size_md"
        android:contentDescription="@string/cd_chevron_right"
        android:src="@drawable/ic_chevron_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>