<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarForm"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/title_tambah_kamar"
        app:titleTextAppearance="@style/TextAppearance.MyKos.Title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- Label & Area Unggah Foto Kamar -->
            <TextView
                style="@style/TextAppearance.MyKos.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_foto_kamar" />

            <FrameLayout
                android:id="@+id/frameUploadFoto"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_upload_placeholder"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:id="@+id/layoutUploadPlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="@dimen/icon_size_lg"
                        android:layout_height="@dimen/icon_size_lg"
                        android:contentDescription="@string/cd_camera_icon"
                        android:src="@drawable/ic_camera" />

                    <TextView
                        style="@style/TextAppearance.MyKos.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/label_upload_foto"
                        android:textColor="@color/primary" />

                    <TextView
                        style="@style/TextAppearance.MyKos.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        android:text="@string/label_upload_foto_hint" />
                </LinearLayout>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivFormFotoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_foto_kamar"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.MyKos.Card" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGantiFoto"
                style="@style/Widget.MyKos.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/label_ganti_foto"
                android:visibility="gone"
                app:icon="@drawable/ic_camera" />

            <!-- Input Nomor Kamar -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNomorKamar"
                style="@style/Widget.MyKos.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/hint_nomor_kamar">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNomorKamar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input Harga Sewa per Bulan -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilHargaSewa"
                style="@style/Widget.MyKos.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/hint_harga_sewa">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHargaSewa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Pilihan Fasilitas -->
            <TextView
                style="@style/TextAppearance.MyKos.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/label_pilih_fasilitas" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFormFasilitas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAc"
                    style="@style/Widget.MyKos.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fasilitas_ac" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipKmDalam"
                    style="@style/Widget.MyKos.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fasilitas_km_dalam" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWifi"
                    style="@style/Widget.MyKos.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fasilitas_wifi" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipKasur"
                    style="@style/Widget.MyKos.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fasilitas_kasur" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLemari"
                    style="@style/Widget.MyKos.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fasilitas_lemari" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMeja"
                    style="@style/Widget.MyKos.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fasilitas_meja" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Dropdown Status Kamar -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStatusKamar"
                style="@style/Widget.MyKos.TextInputLayout.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/hint_status_kamar">

                <AutoCompleteTextView
                    android:id="@+id/actvStatusKamar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Form Data Penghuni (Tampil Jika Status = Terisi) -->
            <LinearLayout
                android:id="@+id/layoutFormPenghuni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_liquid_glass_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md"
                android:visibility="gone">

                <TextView
                    style="@style/TextAppearance.MyKos.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_info_penghuni" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNamaPenghuni"
                    style="@style/Widget.MyKos.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:hint="@string/hint_nama_penghuni">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNamaPenghuni"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNoHp"
                    style="@style/Widget.MyKos.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:hint="@string/hint_no_hp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNoHp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="phone"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTanggalMasuk"
                    style="@style/Widget.MyKos.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:hint="@string/hint_tanggal_masuk">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTanggalMasuk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="false"
                        android:inputType="none"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Tombol Simpan -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimpanKamar"
                style="@style/Widget.MyKos.Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/btn_simpan_kamar" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>