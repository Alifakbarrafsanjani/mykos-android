<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Gradasi Latar Atas Liquid Glass -->
    <View
        android:id="@+id/viewHeaderBg"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="@drawable/bg_liquid_glass_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_lg">

            <TextView
                style="@style/TextAppearance.MyKos.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_profil" />

            <!-- Kartu Informasi Akun Pengguna (Klik untuk Edit Nama) -->
            <LinearLayout
                android:id="@+id/cardProfilUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_liquid_glass_card"
                android:clickable="true"
                android:elevation="@dimen/elevation_sm"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_liquid_glass_card"
                    android:padding="@dimen/spacing_sm">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_person"
                        app:tint="@color/primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfilNama"
                        style="@style/TextAppearance.MyKos.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="Alif Hidayat" />

                    <TextView
                        android:id="@+id/tvProfilEmail"
                        style="@style/TextAppearance.MyKos.BodySecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="alif@example.com" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:contentDescription="@string/cd_edit_profil"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/primary" />
            </LinearLayout>

            <!-- Label Pengaturan -->
            <TextView
                style="@style/TextAppearance.MyKos.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/label_pengaturan" />

            <!-- Menu 1: Mode Tampilan (Light / Dark / Sistem) -->
            <LinearLayout
                android:id="@+id/itemModeTema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_liquid_glass_card"
                android:clickable="true"
                android:elevation="@dimen/elevation_sm"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <ImageView
                    android:layout_width="@dimen/icon_size_lg"
                    android:layout_height="@dimen/icon_size_lg"
                    android:contentDescription="@string/cd_theme_icon"
                    android:src="@drawable/ic_theme" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.MyKos.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_mode_tema" />

                    <TextView
                        android:id="@+id/tvCurrentTheme"
                        style="@style/TextAppearance.MyKos.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        android:text="@string/tema_sistem" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:contentDescription="@string/cd_chevron_right"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <!-- Menu 2: Ganti Password -->
            <LinearLayout
                android:id="@+id/itemGantiPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_liquid_glass_card"
                android:clickable="true"
                android:elevation="@dimen/elevation_sm"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <ImageView
                    android:layout_width="@dimen/icon_size_lg"
                    android:layout_height="@dimen/icon_size_lg"
                    android:contentDescription="@string/cd_ganti_password"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.MyKos.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_ganti_password" />

                    <TextView
                        style="@style/TextAppearance.MyKos.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        android:text="@string/menu_ganti_password_desc" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:contentDescription="@string/cd_chevron_right"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <!-- Menu 3: Unduh Data Kamar Terisi (PDF) -->
            <LinearLayout
                android:id="@+id/itemExportTerisi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_liquid_glass_card"
                android:clickable="true"
                android:elevation="@dimen/elevation_sm"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <ImageView
                    android:layout_width="@dimen/icon_size_lg"
                    android:layout_height="@dimen/icon_size_lg"
                    android:contentDescription="@string/cd_export_terisi"
                    android:src="@drawable/ic_download" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.MyKos.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_export_terisi" />

                    <TextView
                        style="@style/TextAppearance.MyKos.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        android:text="@string/menu_export_terisi_desc" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:contentDescription="@string/cd_chevron_right"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <!-- Menu 4: Pengingat Jatuh Tempo Sewa (Notifikasi) -->
            <LinearLayout
                android:id="@+id/itemCekNotifikasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_liquid_glass_card"
                android:clickable="true"
                android:elevation="@dimen/elevation_sm"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <ImageView
                    android:layout_width="@dimen/icon_size_lg"
                    android:layout_height="@dimen/icon_size_lg"
                    android:contentDescription="@string/cd_notifikasi"
                    android:src="@drawable/ic_notifications" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.MyKos.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_notifikasi_sewa" />

                    <TextView
                        style="@style/TextAppearance.MyKos.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        android:text="@string/menu_notifikasi_sewa_desc" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:contentDescription="@string/cd_chevron_right"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <!-- Menu 5: Tentang Aplikasi -->
            <LinearLayout
                android:id="@+id/itemTentangAplikasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_liquid_glass_card"
                android:clickable="true"
                android:elevation="@dimen/elevation_sm"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <ImageView
                    android:layout_width="@dimen/icon_size_lg"
                    android:layout_height="@dimen/icon_size_lg"
                    android:contentDescription="@string/cd_info_icon"
                    android:src="@drawable/ic_info" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.MyKos.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_tentang_aplikasi" />

                    <TextView
                        style="@style/TextAppearance.MyKos.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        android:text="@string/app_version_info" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:contentDescription="@string/cd_chevron_right"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <!-- Tombol Keluar Akun -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.MyKos.Button.Danger"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/btn_keluar" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>