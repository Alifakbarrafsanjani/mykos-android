<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDetail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/title_detail_kamar"
        app:titleTextAppearance="@style/TextAppearance.MyKos.Title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- Foto Utama Kamar -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDetailFoto"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@color/surface_elevated"
                android:contentDescription="@string/cd_foto_kamar"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MyKos.Card"
                tools:src="@drawable/ic_image_placeholder" />

            <!-- Kartu Ringkasan Nomor, Status, Harga -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_liquid_glass_card"
                android:elevation="@dimen/elevation_sm"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDetailNomorKamar"
                        style="@style/TextAppearance.MyKos.Headline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="Kamar 101" />

                    <TextView
                        android:id="@+id/tvDetailStatusBadge"
                        style="@style/TextAppearance.MyKos.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_terisi"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:paddingVertical="@dimen/spacing_xs"
                        android:textColor="@color/on_success_container"
                        android:textStyle="bold"
                        tools:text="@string/status_terisi" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDetailHarga"
                    style="@style/TextAppearance.MyKos.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textColor="@color/primary"
                    tools:text="Rp 750.000/bulan" />
            </LinearLayout>

            <!-- Kartu Fasilitas Kamar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_liquid_glass_card"
                android:elevation="@dimen/elevation_sm"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    style="@style/TextAppearance.MyKos.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_fasilitas" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupDetailFasilitas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm" />
            </LinearLayout>

            <!-- Kartu Informasi Penghuni -->
            <LinearLayout
                android:id="@+id/cardInfoPenghuni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_liquid_glass_card"
                android:elevation="@dimen/elevation_sm"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    style="@style/TextAppearance.MyKos.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_info_penghuni" />

                <!-- Konten Saat Status Terisi -->
                <LinearLayout
                    android:id="@+id/layoutPenghuniTerisi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.MyKos.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_nama_penghuni" />

                    <TextView
                        android:id="@+id/tvDetailNamaPenghuni"
                        style="@style/TextAppearance.MyKos.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        android:textStyle="bold"
                        tools:text="Budi Santoso" />

                    <TextView
                        style="@style/TextAppearance.MyKos.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/label_no_hp" />

                    <TextView
                        android:id="@+id/tvDetailNoHp"
                        style="@style/TextAppearance.MyKos.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        android:textStyle="bold"
                        tools:text="081234567890" />

                    <TextView
                        style="@style/TextAppearance.MyKos.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/label_tanggal_masuk" />

                    <TextView
                        android:id="@+id/tvDetailTanggalMasuk"
                        style="@style/TextAppearance.MyKos.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        android:textStyle="bold"
                        tools:text="01 November 2026" />

                    <!-- Tombol WhatsApp & Telepon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHubungiWa"
                            style="@style/Widget.MyKos.Button.Success"
                            android:layout_width="0dp"
                            android:layout_marginEnd="@dimen/spacing_xs"
                            android:layout_weight="1"
                            android:text="@string/btn_hubungi_wa"
                            app:icon="@drawable/ic_whatsapp"
                            app:iconGravity="textStart" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTelepon"
                            style="@style/Widget.MyKos.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:layout_weight="1"
                            android:text="@string/btn_telepon"
                            app:icon="@drawable/ic_phone"
                            app:iconGravity="textStart" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Konten Saat Status Kosong -->
                <TextView
                    android:id="@+id/layoutPenghuniKosong"
                    style="@style/TextAppearance.MyKos.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/label_kosong_belum_ada_penghuni"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Tombol Edit & Hapus Kamar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditKamar"
                    style="@style/Widget.MyKos.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:text="@string/btn_edit"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHapusKamar"
                    style="@style/Widget.MyKos.Button.Danger"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:text="@string/btn_hapus"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <!-- Tombol Unduh Data Kamar Ini (Tampil Saat Status Terisi) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUnduhDataKamar"
                style="@style/Widget.MyKos.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/btn_unduh_detail_kamar"
                android:visibility="gone"
                app:icon="@drawable/ic_download"
                app:iconGravity="textStart"
                app:iconTint="@color/primary" />

            <!-- Tombol Bagikan / Kirim PDF ke WhatsApp Penghuni -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKirimPdfWa"
                style="@style/Widget.MyKos.Button.Success"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/btn_kirim_pdf_wa"
                android:visibility="gone"
                app:icon="@drawable/ic_whatsapp"
                app:iconGravity="textStart" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>