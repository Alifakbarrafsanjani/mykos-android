<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_lg"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingBottom="@dimen/spacing_lg">

    <View
        android:layout_width="@dimen/sheet_handle_width"
        android:layout_height="@dimen/sheet_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_md"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <TextView
        android:id="@+id/tvPickerTitle"
        style="@style/TextAppearance.MyKos.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/picker_title" />

    <!-- Opsi Kamera -->
    <LinearLayout
        android:id="@+id/optionKamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:background="@drawable/bg_liquid_glass_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md">

        <ImageView
            android:layout_width="@dimen/icon_size_lg"
            android:layout_height="@dimen/icon_size_lg"
            android:contentDescription="@string/cd_camera_icon"
            android:src="@drawable/ic_camera" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.MyKos.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/picker_kamera" />

            <TextView
                style="@style/TextAppearance.MyKos.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/picker_kamera_desc" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/icon_size_md"
            android:layout_height="@dimen/icon_size_md"
            android:contentDescription="@string/cd_chevron_right"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <!-- Opsi Galeri -->
    <LinearLayout
        android:id="@+id/optionGaleri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="@drawable/bg_liquid_glass_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md">

        <ImageView
            android:layout_width="@dimen/icon_size_lg"
            android:layout_height="@dimen/icon_size_lg"
            android:contentDescription="@string/cd_gallery_icon"
            android:src="@drawable/ic_gallery" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.MyKos.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/picker_galeri" />

            <TextView
                style="@style/TextAppearance.MyKos.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/picker_galeri_desc" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/icon_size_md"
            android:layout_height="@dimen/icon_size_md"
            android:contentDescription="@string/cd_chevron_right"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPickerCancel"
        style="@style/Widget.MyKos.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="@string/btn_batal"
        app:strokeColor="@color/border" />

</LinearLayout>