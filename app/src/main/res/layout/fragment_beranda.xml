<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Gradasi Latar Atas Editorial -->
    <View
        android:id="@+id/viewHeaderBg"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_liquid_glass_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Editorial Hero Header -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHeroHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginTop="@dimen/spacing_lg"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="@dimen/radius_card"
        app:cardElevation="@dimen/elevation_none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/border"
        app:strokeWidth="@dimen/stroke_thin">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_md">

            <!-- Eyebrow Label -->
            <TextView
                android:id="@+id/tvHeaderEyebrow"
                style="@style/TextAppearance.MyKos.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:letterSpacing="0.12"
                android:text="HUNIAN &amp; PROPERTI"
                android:textColor="@color/secondary"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/badgeInitial"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Sapaan Utama -->
            <TextView
                android:id="@+id/tvGreeting"
                style="@style/TextAppearance.MyKos.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/beranda_greeting_default"
                app:layout_constraintEnd_toStartOf="@id/badgeInitial"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHeaderEyebrow" />

            <!-- Subjudul -->
            <TextView
                android:id="@+id/tvDashboardSubtitle"
                style="@style/TextAppearance.MyKos.BodySecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/beranda_subtitle"
                app:layout_constraintEnd_toStartOf="@id/badgeInitial"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvGreeting" />

            <!-- Badge Inisial Pemilik -->
            <FrameLayout
                android:id="@+id/badgeInitial"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_status_terisi"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvUserInitial"
                    style="@style/TextAppearance.MyKos.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="A"
                    android:textColor="@color/on_success_container" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3 Kartu Statistik (Total, Terisi, Kosong) -->
    <LinearLayout
        android:id="@+id/layoutStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginTop="@dimen/spacing_md"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardHeroHeader">

        <include
            android:id="@+id/statTotal"
            layout="@layout/view_stat_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:layout_weight="1" />

        <include
            android:id="@+id/statTerisi"
            layout="@layout/view_stat_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_xs"
            android:layout_weight="1" />

        <include
            android:id="@+id/statKosong"
            layout="@layout/view_stat_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Kartu Ringkasan Keuangan: Estimasi Pemasukan Bulanan -->
    <LinearLayout
        android:id="@+id/cardEstimasiPemasukan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="@drawable/bg_liquid_glass_card"
        android:elevation="@dimen/elevation_sm"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutStats">

        <TextView
            style="@style/TextAppearance.MyKos.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_estimasi_pemasukan"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEstimasiPemasukan"
            style="@style/TextAppearance.MyKos.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/success"
            tools:text="Rp 19.200.000" />
    </LinearLayout>

    <!-- Bar Pencarian, Urutkan & Unduh Laporan Terisi -->
    <LinearLayout
        android:id="@+id/layoutSearchSort"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginTop="@dimen/spacing_sm"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardEstimasiPemasukan">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearchKamar"
            style="@style/Widget.MyKos.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_cari_kamar"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearchKamar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <FrameLayout
            android:id="@+id/btnSortKamar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/bg_liquid_glass_card"
            android:clickable="true"
            android:contentDescription="@string/cd_sort_kamar"
            android:elevation="@dimen/elevation_sm"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="@dimen/icon_size_md"
                android:layout_height="@dimen/icon_size_md"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_sort_kamar"
                android:src="@drawable/ic_sort" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnExportTerisi"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="@dimen/spacing_xs"
            android:background="@drawable/bg_liquid_glass_card"
            android:clickable="true"
            android:contentDescription="@string/cd_export_terisi"
            android:elevation="@dimen/elevation_sm"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="@dimen/icon_size_md"
                android:layout_height="@dimen/icon_size_md"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_export_terisi"
                android:src="@drawable/ic_download" />
        </FrameLayout>
    </LinearLayout>

    <!-- Filter Chips (Semua, Terisi, Kosong) -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFilter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginTop="@dimen/spacing_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutSearchSort"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFilterSemua"
            style="@style/Widget.MyKos.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/filter_semua" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFilterTerisi"
            style="@style/Widget.MyKos.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_terisi" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFilterKosong"
            style="@style/Widget.MyKos.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_kosong" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Kontainer Daftar Kamar & State Views -->
    <FrameLayout
        android:id="@+id/containerListKamar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_xs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipGroupFilter">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvKamar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingBottom="100dp"
            tools:listitem="@layout/item_kamar" />

        <include
            android:id="@+id/stateEmpty"
            layout="@layout/layout_state_empty"
            android:visibility="gone" />

        <include
            android:id="@+id/stateError"
            layout="@layout/layout_state_error"
            android:visibility="gone" />

        <include
            android:id="@+id/stateLoading"
            layout="@layout/layout_state_loading"
            android:visibility="gone" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>