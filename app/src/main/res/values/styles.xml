<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ==================== TYPOGRAPHY (Editorial Clean) ==================== -->
    <style name="TextAppearance.MyKos.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <style name="TextAppearance.MyKos.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.MyKos.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="TextAppearance.MyKos.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.MyKos.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextAppearance.MyKos.BodySecondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextAppearance.MyKos.Caption" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.MyKos.StatNumber" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_stat_number</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>

    <!-- ==================== SHAPE APPEARANCES ==================== -->
    <style name="ShapeAppearance.MyKos.Card" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card</item>
    </style>

    <style name="ShapeAppearance.MyKos.ImageRounded" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_input</item>
    </style>

    <style name="ShapeAppearance.MyKos.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.MyKos.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_sheet</item>
        <item name="cornerSizeTopRight">@dimen/radius_sheet</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ==================== BUTTONS ==================== -->
    <style name="Widget.MyKos.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">@dimen/radius_input</item>
        <item name="elevation">@dimen/elevation_none</item>
    </style>

    <style name="Widget.MyKos.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
        <item name="cornerRadius">@dimen/radius_input</item>
    </style>

    <style name="Widget.MyKos.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_height">@dimen/button_height_sm</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/primary</item>
        <item name="backgroundTint">@color/tertiary</item>
        <item name="iconTint">@color/primary</item>
        <item name="cornerRadius">@dimen/radius_input</item>
    </style>

    <style name="Widget.MyKos.Button.Success" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/button_height_sm</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/success</item>
        <item name="iconTint">@android:color/white</item>
        <item name="cornerRadius">@dimen/radius_input</item>
    </style>

    <style name="Widget.MyKos.Button.Danger" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/on_error_container</item>
        <item name="backgroundTint">@color/error_container</item>
        <item name="iconTint">@color/on_error_container</item>
        <item name="cornerRadius">@dimen/radius_input</item>
    </style>

    <!-- ==================== INPUT FIELDS ==================== -->
    <style name="Widget.MyKos.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/border</item>
        <item name="boxStrokeWidth">@dimen/stroke_thin</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_medium</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="hintTextColor">@color/primary</item>
    </style>

    <style name="Widget.MyKos.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/border</item>
        <item name="boxStrokeWidth">@dimen/stroke_thin</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_medium</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
    </style>

    <!-- ==================== CHIPS ==================== -->
    <style name="Widget.MyKos.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="chipCornerRadius">@dimen/radius_pill</item>
        <item name="chipStrokeWidth">@dimen/stroke_thin</item>
        <item name="chipStrokeColor">@color/border</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <style name="Widget.MyKos.Chip.Tag" parent="Widget.Material3.Chip.Assist">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="chipCornerRadius">@dimen/radius_pill</item>
        <item name="chipBackgroundColor">@color/surface_elevated</item>
        <item name="chipStrokeWidth">@dimen/stroke_thin</item>
        <item name="chipStrokeColor">@color/border</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:clickable">false</item>
    </style>
</resources>