<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.MyKos" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>

        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorPrimaryContainer">@color/tertiary</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>
        <item name="colorSecondaryContainer">@color/surface_elevated</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>

        <item name="colorTertiary">@color/tertiary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_elevated</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="colorOutline">@color/border</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/text_on_primary</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="bottomSheetDialogTheme">@style/Theme.MyKos.BottomSheetDialog</item>
    </style>

    <style name="Theme.MyKos" parent="Base.Theme.MyKos" />

    <style name="Theme.MyKos.Splash" parent="Theme.MyKos">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/splash_gradient_end</item>
    </style>

    <style name="Theme.MyKos.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.MyKos.BottomSheet</item>
    </style>

    <style name="Widget.MyKos.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.MyKos.BottomSheet</item>
        <item name="backgroundTint">@color/surface</item>
    </style>
</resources>